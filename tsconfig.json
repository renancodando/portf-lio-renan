{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/*.tsx",
    "components/portfolio.tsx",
    "components/ocean-scene.tsx",
    "components/detail-panels.tsx",
    "components/ui/button.tsx",
    "components/ui/dialog.tsx",
    "content/*.ts",
    "lib/utils.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-vercel",
    "visual-studio"
  ]
}
